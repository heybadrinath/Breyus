# =============================================================================
# Breyus Platform - Docker Environment Variables
# =============================================================================
# Generated with L6 embedding model for faster processing
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB (Main Application Database)
MONGO_ROOT_USERNAME=breyus
MONGO_ROOT_PASSWORD=breyus_secret

# PostgreSQL (AI Database with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_SECRET_KEY=breyus-dev-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=3600

# Cookie Configuration
COOKIE_SECRET=breyus-dev-cookie-secret-key
COOKIE_EXPIRY_LOGIN=3600000

# =============================================================================
# APPLICATION URLS
# =============================================================================

# CORS Origin
CORS_ORIGIN=http://localhost

# Admin Portal URL
ADMIN_PORTAL_URL=http://localhost/admin
ADMIN_SESSION_EXPIRY=86400000

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=heybadrinath@gmail.com
SMTP_PASS=gwushwrwdcmcglbb
EMAIL_FROM=heybadrinath@gmail.com
EMAIL_FROM_NAME=Breyus

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================

# Enable/Disable debug mode
DEBUG=false

# AI Provider Configuration
AI_PROVIDER=gemini
AI_API_KEY=

# Anthropic API (Claude)
ANTHROPIC_API_KEY=

# Google Gemini API
GEMINI_API_KEY=AIzaSyD2uk4__jJLfEqpWaAAOGJbY0ctGJBvmN0,AIzaSyAyPH5VZnqRNp4rctwymHj36aboTeLQj4Y,AIzaSyDQqGPfzEcKCW7h6OdVW7k5PCQS8olgCEM,AIzaSyD476vukhnmKLYmlnDrYorb0R-3RflaplM,AIzaSyCPovCIKStc4o_Jtr8nNo0pH50Rjp390Xk,AIzaSyAaBSlH9RRbxVuxLAy2yp_m9Kwc8C_vJgQ
GEMINI_MODEL=gemini-flash-latest

# Model Settings
LLM_MODEL=claude-3-sonnet-20240229

# CHANGED: Using L6 model for 2x faster embedding generation
# Original: sentence-transformers/all-MiniLM-L12-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Caching
CACHE_ENABLED=true

# Pipeline Developer Name
PIPELINE_DEV_NAME=claude-ai
