# Breyus Backend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# SERVER
# =============================================================================
NODE_ENV=development
PORT=3001

# =============================================================================
# DATABASE
# =============================================================================
# MongoDB (local development)
MONGODB_URI_DEV=mongodb://localhost:27017/breyus

# MongoDB (production - use container name in Docker)
# MONGODB_URI_PROD=mongodb://mongo:27017/breyus

# Redis
REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=3600

COOKIE_SECRET=your-super-secret-cookie-key-change-in-production
COOKIE_EXPIRY_LOGIN=3600000

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@breyus.com
EMAIL_FROM_NAME=Breyus

# Legacy Sendinblue (if still used)
# SENDINBLUE_API_KEY=your-sendinblue-api-key

# =============================================================================
# AI SERVICE
# =============================================================================
AI_SERVICE_URL=http://localhost:8000

# =============================================================================
# STORAGE (DigitalOcean Spaces / S3-Compatible)
# =============================================================================
# Storage Provider: 'local' for local filesystem, 's3' for S3-compatible storage
STORAGE_PROVIDER=local

# S3-Compatible Storage Configuration (Vultr, AWS, DigitalOcean, etc.)
# Uncomment and configure for production:
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
# S3_REGION=sgp1
# S3_ACCESS_KEY=your-digitalocean-access-key
# S3_SECRET_KEY=your-digitalocean-secret-key
# S3_BUCKET=breyus-uploads

# =============================================================================
# ADMIN PORTAL
# =============================================================================
ADMIN_PORTAL_URL=http://localhost:5173
ADMIN_SESSION_EXPIRY=86400000

# =============================================================================
# INVOICE GENERATION
# =============================================================================
# Custom logo path for invoice PDFs (optional - uses default paths if not set)
# INVOICE_LOGO_PATH=/path/to/your/logo.png

# =============================================================================
# GST VERIFICATION (Cashfree - for Indian companies)
# =============================================================================
# Get your credentials from: https://merchant.cashfree.com/
# Free 100 credits for GST verification
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_BASE_URL=https://api.cashfree.com
