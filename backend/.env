# --- Environment Settings ---
NODE_ENV=development          # change to 'production' on prod
PORT=5000
APP_NAME=BreyusBackend



# --- MongoDB Settings ---
# Use your local dev DB URI or production cluster URI here
MONGODB_URI_DEV=mongodb://localhost:27017/breyus_dev
MONGODB_URI_PROD=mongodb+srb://prod_user:prod_pass@prod_host:27017/breyus_prod

    
# --- JWT Settings ---
JWT_SECRET=your_development_jwt_secret_key
JWT_EXPIRES_IN=3600s               # 1 hour expiry; can shorten or lengthen for prod

# --- CORS Settings ---
CORS_ORIGIN=http://localhost:3000   # your React frontend URL dev
# For prod, you would change to https://breyus.com
CORS_CREDENTIALS=true         # allow cookies and auth headers

# --- Logging Settings ---
LOG_LEVEL=debug                     # debug for dev; info or warn for prod
LOG_DIR=logs
LOG_FILE=breyus.log

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000          # 1 minute window
RATE_LIMIT_MAX_REQUESTS=100         # max requests per window

# --- Email Service (Brevo) ---
EMAIL_SERVICE_API_KEY=api_key
EMAIL_FROM=no-reply@breyus.com

# --- Session (if using sessions) ---
SESSION_SECRET=your_session_secret
SESSION_COOKIE_NAME=breyus_session
SESSION_COOKIE_MAX_AGE=86400000     # 1 day in ms
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SECURE=false         # true in production with HTTPS
SESSION_COOKIE_SAME_SITE=Lax

# --- Other (optional) ---
API_PREFIX=/api/v1
ENABLE_API_DOCS=true             # enable swagger docs in dev, disable in prod

