# =============================================================================
# Breyus Platform - Docker Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before running:
#   docker-compose up -d --build
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB (Main Application Database)
# These credentials are used for the local Docker MongoDB container
MONGO_ROOT_USERNAME=breyus
MONGO_ROOT_PASSWORD=breyus_secret_change_me

# PostgreSQL (AI Database with pgvector)
# These credentials are used for the local Docker PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_change_me

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=3600

# Cookie Configuration
COOKIE_SECRET=your-super-secret-cookie-key-change-in-production
COOKIE_EXPIRY_LOGIN=3600000

# =============================================================================
# APPLICATION URLS
# =============================================================================

# CORS Origin (use http://localhost for local Docker, or your domain for production)
CORS_ORIGIN=http://localhost

# Admin Portal URL (used for generating admin links in emails)
ADMIN_PORTAL_URL=http://localhost/admin
ADMIN_SESSION_EXPIRY=86400000

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@breyus.com
EMAIL_FROM_NAME=Breyus

# =============================================================================
# STORAGE CONFIGURATION (DigitalOcean Spaces / S3-Compatible)
# =============================================================================

# Storage Provider: 'local' for local filesystem, 's3' for S3-compatible storage
STORAGE_PROVIDER=s3

# S3-Compatible Storage Configuration (DigitalOcean, AWS, DigitalOcean, etc.)
# For DigitalOcean Spaces:
S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_REGION=sgp1
S3_ACCESS_KEY=your-digitalocean-access-key
S3_SECRET_KEY=your-digitalocean-secret-key
S3_BUCKET=breyus-uploads

# Additional buckets (optional - defaults to S3_BUCKET if not set)
# S3_BUCKET_UPLOADS=breyus-uploads
# S3_BUCKET_AI_DATA=breyus-ai-data
# S3_BUCKET_BACKUPS=breyus-backups

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================

# Enable/Disable debug mode for AI service
DEBUG=false

# AI Provider Configuration
AI_PROVIDER=gemini
AI_API_KEY=

# Anthropic API (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Model Settings
LLM_MODEL=claude-3-sonnet-20240229
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2

# Caching
CACHE_ENABLED=true

# Pipeline Developer Name (for AI pipeline logs)
PIPELINE_DEV_NAME=local-dev

# =============================================================================
# DOCKER-SPECIFIC NOTES
# =============================================================================
#
# The following environment variables are automatically set in docker-compose.yml
# and use Docker internal networking:
#
# - MONGODB_URI_PROD: mongodb://mongo:27017/breyus (uses container name)
# - REDIS_URL: redis://redis:6379 (uses container name)
# - AI_SERVICE_URL: http://ai-service:8000 (uses container name)
# - POSTGRES_HOST: postgres (container name)
#
# You don't need to set these in .env, but they are listed for reference.
#
# =============================================================================
