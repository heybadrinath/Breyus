# Breyus AI Server Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# SERVER
# =============================================================================
DEBUG=false
AI_SERVER_PORT=8000
AI_API_KEY=your-secret-api-key-here

# =============================================================================
# BACKEND API (NestJS)
# =============================================================================
# URL of the NestJS backend for fetching commodity classifications
# Development: http://localhost:3001
# Docker: http://backend:3001
BACKEND_URL=http://localhost:3001
LOG_LEVEL=INFO
REQUEST_LOG_SAMPLE_RATE=1.0
CACHE_ENABLED=true
# ALLOW_ORIGINS=[]  # Optional allowlist, keep empty for wildcard

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=breyus_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_MIN_CONN=5
POSTGRES_MAX_CONN=20

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_JOB_TTL_SEC=900
REDIS_CACHE_TTL_SEC=900

# =============================================================================
# LLM (ANTHROPIC)
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_MODEL=claude-3-sonnet-20240229
AI_PROVIDER=gemini

# =============================================================================
# LLM (GEMINI - optional)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# =============================================================================
# EMBEDDINGS
# =============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=100

# =============================================================================
# RETENTION (Postgres cache TTLs, in days)
# =============================================================================
TTL_LINK_PREDICTION_DAYS=14
TTL_TRADE_SCORE_DAYS=7
TTL_ANALYSIS_DAYS=30

# =============================================================================
# PIPELINE
# =============================================================================
PIPELINE_DEV_NAME=developer

# =============================================================================
# OBJECT STORAGE (DigitalOcean Spaces (S3-Compatible))
# =============================================================================
# Used for storing/retrieving AI pipeline data files
S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_REGION=sgp1
S3_ACCESS_KEY=your-digitalocean-access-key
S3_SECRET_KEY=your-digitalocean-secret-key
S3_BUCKET_AI_DATA=breyus-ai-data

# =============================================================================
# GOOGLE DRIVE SYNC (for VPS data pipeline)
# =============================================================================
# Folder ID from Google Drive URL: drive.google.com/drive/folders/<FOLDER_ID>
GDRIVE_FOLDER_ID=your_drive_folder_id

# OAuth 2.0 credentials from Google Cloud Console
# Create at: https://console.cloud.google.com/apis/credentials
# Type: Desktop application
GDRIVE_CLIENT_ID=your_oauth_client_id
GDRIVE_CLIENT_SECRET=your_oauth_client_secret

# Refresh token obtained by running: python -m pipeline.scripts.cli drive-auth
GDRIVE_REFRESH_TOKEN=your_refresh_token
